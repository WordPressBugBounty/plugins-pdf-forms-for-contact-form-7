#: pdf-forms-for-contact-form-7.php:2548
msgid "PDF form fields"
msgstr "Pola formularza PDF"

#: pdf-forms-for-contact-form-7.php:2550
msgid "Once you {a-href-panel-link}attach a PDF file with fields to your form{/a}, you will be able to generate form-tags that are linked to PDF form fields."
msgstr "Po {a-href-panel-link}dołączeniu do formularza pliku PDF z polami{/a} można generować znaczniki formularza powiązane z polami formularza PDF."

