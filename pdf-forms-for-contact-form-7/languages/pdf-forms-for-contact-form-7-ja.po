msgid "Attach to primary email message"
msgstr "メインメールに添付"

#: pdf-forms-for-contact-form-7.php:705
msgid "Attach to secondary email message"
msgstr "メール (2) に添付"

#: pdf-forms-for-contact-form-7.php:706
msgid "Flatten"
