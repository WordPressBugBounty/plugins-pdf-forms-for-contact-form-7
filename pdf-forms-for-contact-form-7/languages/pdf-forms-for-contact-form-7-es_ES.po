#: pdf-forms-for-contact-form-7.php:3
#: pdf-forms-for-contact-form-7.php:2436
msgid "PDF Forms Filler for CF7"
msgstr "Herramienta de relleno de formularios PDF para CF7"

#. Plugin URI of the plugin
#: pdf-forms-for-contact-form-7.php:4
msgid "https://pdfformsfiller.org/"
msgstr "https://pdfformsfiller.org/"

#. Description of the plugin
#: pdf-forms-for-contact-form-7.php:5
msgid "Build Contact Form 7 forms from PDF forms. Get PDFs auto-filled and attached to email messages and/or website responses on form submission."
msgstr "Crea formularios de Contact Form 7 a partir de formularios PDF. Obtén archivos PDF rellenados automáticamente y adjuntos a los mensajes de correo electrónico y/o a las respuestas del sitio web al enviar el formulario."

